rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: check if user has superadmin role
    function isSuperAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    // Helper: check if user has admin OR superadmin role
    function isAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    // Users: authenticated users can read their own doc; admins can read all
    // Gerarchia aggiornamenti: superadmin > admin > viewer
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuth() && request.auth.uid == userId;

      // Il superadmin può modificare qualsiasi utente.
      // Un admin può auto-promuoversi a superadmin solo sul proprio documento
      // (migrazione one-time per l'owner dell'app) e solo cambiando il campo role.
      // Un admin normale può modificare solo i viewer (non altri admin né superadmin)
      // e non può promuovere nessuno a superadmin.
      // Eccezione: qualsiasi admin può aggiornare linkedPlayerId/linkedPlayerUpdatedAt
      // su qualsiasi utente (collegamento scheda giocatore → account Google).
      // Non è un'escalation di privilegi: non tocca role, email o altri campi sensibili.
      allow update: if isSuperAdmin() ||
                       (isAuth() && request.auth.uid == userId &&
                        resource.data.role == 'admin' &&
                        request.resource.data.role == 'superadmin' &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])) ||
                       (isAdmin() &&
                        resource.data.role != 'superadmin' &&
                        resource.data.role != 'admin' &&
                        request.resource.data.role != 'superadmin') ||
                       (isAdmin() &&
                        resource.data.role != 'superadmin' &&
                        request.resource.data.diff(resource.data).affectedKeys().size() > 0 &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['linkedPlayerId', 'linkedPlayerUpdatedAt']));

      allow delete: if isSuperAdmin() ||
                       (isAdmin() && resource.data.role == 'viewer');
    }

    // Players: authenticated users can read; only admins can write
    match /players/{playerId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Matches: authenticated users can read; only admins can write
    match /matches/{matchId} {
      allow read: if isAuth();
      allow write: if isAdmin();

      // Reactions subcollection: every auth user can read all; each user can only
      // create/update their own doc. Delete: il proprietario o un admin (la pulizia
      // delle reazioni avviene quando un admin elimina la partita).
      match /reactions/{userId} {
        allow read: if isAuth();
        allow create, update: if isAuth() && request.auth.uid == userId;
        allow delete: if (isAuth() && request.auth.uid == userId) || isAdmin();
      }
    }

    // Match States (timer sync): same rules as matches
    match /matchStates/{matchId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Historical Seasons (annali): authenticated users can read; only admins can write
    match /historicalSeasons/{seasonId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Settings (piConfig, ecc.): authenticated users can read; only admins can write.
    // Exception: aiCache_* documents are ephemeral read-cache and can be written by any auth user.
    match /settings/{settingId} {
      allow read: if isAuth();
      allow write: if isAdmin() || (isAuth() && settingId.matches('aiCache_.*'));
    }
  }
}
